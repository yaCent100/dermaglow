# Si l'hébergeur ne permet pas de pointer le site vers le dossier "public/",
# ce fichier redirige tout vers public/ et protège le reste du projet.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.env|app|vendor|writable|spark|composer\.(json|lock)|README\.md)(/|$) - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
