#--------------------------------------------------------------------
# DERMAGLOW – fichier de configuration
# Copier ce fichier en ".env" et remplir les valeurs.
#--------------------------------------------------------------------

# development = affiche les erreurs / production = site en ligne
#CI_ENVIRONMENT = production

# Adresse publique du site (avec / final)
#app.baseURL = 'https://dermaglow.example.com/'
#app.forceGlobalSecureRequests = true

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# BASE DE DONNÉES (MySQL / MariaDB)
#--------------------------------------------------------------------
#database.default.hostname = localhost
#database.default.database = dermaglow
#database.default.username = root
#database.default.password =
#database.default.DBDriver = MySQLi
#database.default.port = 3306

database.default.hostname = mysql-dermaglow.alwaysdata.net
database.default.database = dermaglow_db
database.default.username = dermaglow_user
database.default.password = LE_MOT_DE_PASSE_DE_CET_UTILISATEUR

# Pour tester en local sans MySQL, tu peux utiliser SQLite :
# database.default.DBDriver = SQLite3
# database.default.database = dermaglow.db

#--------------------------------------------------------------------
# STRIPE (acompte en ligne)
# Clés : https://dashboard.stripe.com/apikeys
# Webhook : https://dashboard.stripe.com/webhooks  ->  https://TON-SITE/api/stripe/webhook
#   événements : checkout.session.completed, checkout.session.expired
# Laisser vide en local = mode "paiement simulé" (development uniquement)
#--------------------------------------------------------------------
STRIPE_SECRET_KEY =
STRIPE_PUBLISHABLE_KEY =
STRIPE_WEBHOOK_SECRET =

#--------------------------------------------------------------------
# E-MAILS (SMTP) – ex. Brevo (gratuit 300 mails/jour) : smtp-relay.brevo.com
# Si SMTP_HOST est vide, les e-mails sont enregistrés dans writable/emails/
#--------------------------------------------------------------------
SMTP_HOST =
SMTP_PORT = 587
SMTP_USER =
SMTP_PASS =
SMTP_CRYPTO = tls
MAIL_FROM = contact@dermaglow.example.com
MAIL_FROM_NAME = DermaGlow
# Adresse qui reçoit les notifications (nouveaux RDV, messages…)
MAIL_ADMIN = contact@dermaglow.example.com

#--------------------------------------------------------------------
# INSTALLATION EN LIGNE (hébergeur sans SSH)
# Ouvrir une fois : https://TON-SITE/install?key=LA_CLE
# Choisir une clé longue et secrète. Vider la ligne après l'installation.
#--------------------------------------------------------------------
INSTALL_KEY =

# Tâches planifiées (rappels J-1, libération des créneaux) :
# appeler https://TON-SITE/cron?key=CRON_KEY toutes les heures (cron-job.org est gratuit)
CRON_KEY = 

# Compte admin créé à l'installation
ADMIN_EMAIL = admin@dermaglow.example.com
ADMIN_PASSWORD = ChangeMoi!2026
